# ---- Backend (Express) ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ---- Auth / session ----
# 48+ random bytes, e.g. node --input-type=commonjs -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<your-session-secret>
BCRYPT_ROUNDS=12

# ---- SMTP (email verification) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="ACCESS CENTER" <contact@accesscenter.ma>

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=accesscenter
DB_CONNECTION_LIMIT=10

# ---- Private course videos ----
# Absolute path outside public_html is recommended on the server.
# Relative paths are resolved from the project root.
VIDEO_DIR=./storage/videos
